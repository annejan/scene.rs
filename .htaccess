# One name: www.scene.rs goes to scene.rs (http:// already redirects in the vhost)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.scene\.rs$ [NC]
RewriteRule ^ https://scene.rs%{REQUEST_URI} [R=301,L]
# Security headers (internet.nl). The page's script and style are files here, nothing inline.
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
# /pets runs WebAssembly: allow compiling it ('wasm-unsafe-eval' permits wasm only, not JS eval).
<If "%{REQUEST_URI} =~ m#^/pets/#">
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
</If>
# /runs shows each run's film and the renderer's queue, made and served on vidr.nl (server/films).
<If "%{REQUEST_URI} =~ m#^/runs/#">
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://vidr.nl; media-src 'self' https://vidr.nl; connect-src 'self' https://vidr.nl; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
</If>
# No HTTP compression (BREACH)
SetEnv no-gzip 1
