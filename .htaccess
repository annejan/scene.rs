# Security headers (internet.nl). The page's script and style are files here, nothing inline.
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
# /pets runs WebAssembly: allow compiling it ('wasm-unsafe-eval' permits wasm only, not JS eval).
<If "%{REQUEST_URI} =~ m#^/pets/#">
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
</If>
# No HTTP compression (BREACH)
SetEnv no-gzip 1
